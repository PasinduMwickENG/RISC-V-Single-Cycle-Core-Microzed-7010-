WORKFLOW_OPERATION simulation,dialog;

DEFINE_MEMORY_TYPE dmem_bram_MEM_DEVICE [0x00002000] 32;
DEFINE_MEMORY_TYPE imem_bram_MEM_DEVICE [0x00002000] 32;

ADDRESS_MAP processing_system7_0 ARM 100 processing_system7_0
   ADDRESS_SPACE dmem_bram_ADDR_SPACE dmem_bram_MEM_DEVICE  [0x40000000:0x40001FFF] axi_bram_ctrl_dmem
     BUS_BLOCK
      dmem_bram_BUS_BLK [31:0] INPUT = "design_1_dmem_bram_0.mem";
     END_BUS_BLOCK;
   END_ADDRESS_SPACE;
   ADDRESS_SPACE imem_bram_ADDR_SPACE imem_bram_MEM_DEVICE  [0x42000000:0x42001FFF] axi_bram_ctrl_imem
     BUS_BLOCK
      imem_bram_BUS_BLK [31:0] INPUT = "design_1_imem_bram_0.mem";
     END_BUS_BLOCK;
   END_ADDRESS_SPACE;
END_ADDRESS_MAP;
